    },
    {
      "library": "datatables.net-buttons-bs5@3.2.5",
      "files": [ "css/*.css", "js/*.js" ]
    },
    {
      "library": "urijs@1.19.11",
      "files": [ "src/URI.js", "src/URI.min.js" ]
    }
  ]
}
