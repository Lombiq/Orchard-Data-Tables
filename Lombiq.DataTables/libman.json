{
  "version": "3.0",
  "defaultProvider": "jsdelivr",
  "libraries": [
    {
      "library": "datatables.net@2.3.4",
      "destination": "wwwroot/vendors/datatables.net",
      "files": [ "**/*.js" ]
    },
    {
      "library": "datatables.net-bs5@2.3.4",
      "destination": "wwwroot/vendors/datatables.net-bs5",
      "files": [ "**/*.css", "**/*.js" ]
    },
    {
      "library": "datatables.net-buttons@3.2.5",
      "destination": "wwwroot/vendors/datatables.net-buttons",
      "files": [ "**/*.js" ]
    },
    {
      "library": "datatables.net-buttons-bs5@3.2.5",
      "destination": "wwwroot/vendors/datatables.net-buttons-bs5",
      "files": [ "**/*.css", "**/*.js" ]
    },
    {
      "library": "urijs@1.19.11",
      "destination": "wwwroot/vendors/urijs",
      "files": [ "**/*.js" ]
    }
  ]
}
